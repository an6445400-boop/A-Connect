<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">

<title>إلى عائشة ❤️</title>

<style>
*{
  margin:0;
  padding:0;
  box-sizing:border-box;
}

html{
  scroll-behavior:smooth;
}

body{
  font-family:Arial,sans-serif;
  background:#08050a;
  color:white;
  overflow-x:hidden;
}

/* الخلفية */

body::before{
  content:"";
  position:fixed;
  inset:0;
  background:
    radial-gradient(circle at 20% 20%,#70183f,transparent 28%),
    radial-gradient(circle at 80% 80%,#35106b,transparent 30%),
    #08050a;
  z-index:-3;
}

.stars{
  position:fixed;
  inset:0;
  pointer-events:none;
  z-index:-1;
}

.star{
  position:absolute;
  width:2px;
  height:2px;
  background:white;
  border-radius:50%;
  animation:twinkle 3s infinite alternate;
}

@keyframes twinkle{
  from{opacity:.15;transform:scale(.5)}
  to{opacity:1;transform:scale(1.5)}
}

/* الناف بار */

nav{
  position:fixed;
  top:15px;
  left:50%;
  transform:translateX(-50%);
  width:92%;
  max-width:700px;
  padding:13px 18px;

  display:flex;
  justify-content:space-between;
  align-items:center;

  background:rgba(255,255,255,.07);
  border:1px solid rgba(255,255,255,.12);
  border-radius:50px;
  backdrop-filter:blur(18px);

  z-index:100;
}

.logo{
  font-weight:bold;
  color:#ff6c9a;
  font-size:20px;
}

nav a{
  color:#ddd;
  text-decoration:none;
  font-size:13px;
}

/* الصفحة الرئيسية */

.hero{
  min-height:100vh;
  display:flex;
  justify-content:center;
  align-items:center;
  text-align:center;
  padding:100px 20px 50px;
}

.content{
  width:100%;
  max-width:850px;
}

.small{
  display:inline-block;
  padding:8px 18px;
  border-radius:30px;
  background:rgba(255,255,255,.07);
  border:1px solid rgba(255,255,255,.1);
  color:#ffabc3;
  margin-bottom:22px;
}

h1{
  font-size:clamp(45px,11vw,90px);
  margin-bottom:15px;
}

h1 span{
  color:#ff4e83;
  text-shadow:0 0 30px #ff174f;
}

.intro{
  color:#c8bec4;
  font-size:18px;
  line-height:1.8;
}

/* القلب */

.heart-area{
  position:relative;
  width:360px;
  height:340px;
  margin:35px auto;
}

.word{
  position:absolute;
  font-size:11px;
  font-weight:bold;
  color:#ff5d91;
  white-space:nowrap;

  opacity:0;
  transform:scale(0) rotate(-90deg);

  text-shadow:
    0 0 6px #ff2868,
    0 0 15px #ff2868;

  transition:
    opacity .7s ease,
    transform .7s cubic-bezier(.17,.67,.35,1.5);
}

.word.show{
  opacity:1;
  transform:scale(1) rotate(0deg);
}

/* زر */

.btn{
  border:none;
  border-radius:50px;
  padding:14px 27px;
  font-size:16px;
  font-weight:bold;
  cursor:pointer;
  transition:.3s;
}

.main-btn{
  background:linear-gradient(135deg,#ff3f78,#b72b73);
  color:white;
  box-shadow:0 10px 35px rgba(255,45,105,.3);
}

.btn:hover{
  transform:translateY(-4px) scale(1.04);
}

/* الأقسام */

section{
  padding:100px 20px;
}

.title{
  text-align:center;
  margin-bottom:45px;
}

.title h2{
  font-size:34px;
  margin-bottom:10px;
}

.title p{
  color:#aaa;
}

.cards{
  width:100%;
  max-width:1000px;
  margin:auto;

  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
  gap:20px;
}

.card{
  padding:30px;
  min-height:200px;

  background:rgba(255,255,255,.055);
  border:1px solid rgba(255,255,255,.09);
  border-radius:25px;

  backdrop-filter:blur(12px);

  transition:.4s;
}

.card:hover{
  transform:translateY(-10px);
  border-color:#ff4f86;
  box-shadow:0 15px 40px rgba(255,40,100,.12);
}

.icon{
  font-size:38px;
  margin-bottom:18px;
}

.card h3{
  margin-bottom:12px;
}

.card p{
  color:#aaa;
  line-height:1.9;
}

/* الرسالة */

.message-box{
  max-width:750px;
  margin:auto;

  padding:40px 25px;

  text-align:center;

  border-radius:30px;

  background:
    linear-gradient(
      135deg,
      rgba(255,65,120,.12),
      rgba(116,54,180,.1)
    );

  border:1px solid rgba(255,255,255,.1);

  box-shadow:0 20px 60px rgba(0,0,0,.25);
}

#message{
  font-size:21px;
  line-height:2;
  color:#ffe9f0;
  min-height:130px;
  transition:.5s;
}

.message-box button{
  margin-top:20px;
}

/* المفاجأة */

.surprise{
  text-align:center;
}

.secret{
  margin-top:25px;
  font-size:24px;
  color:#ff6694;
  min-height:40px;
}

footer{
  text-align:center;
  padding:45px 20px;
  color:#777;
  border-top:1px solid rgba(255,255,255,.07);
}

footer span{
  color:#ff5688;
}

/* موبايل */

@media(max-width:600px){

  nav{
    width:94%;
  }

  nav a{
    font-size:11px;
  }

  .heart-area{
    transform:scale(.83);
    margin-top:15px;
    margin-bottom:-10px;
  }

  .intro{
    font-size:16px;
  }

  section{
    padding:75px 15px;
  }

}
</style>
</head>

<body>

<div class="stars" id="stars"></div>

<!-- القائمة -->

<nav>

  <div class="logo">A ❤️</div>

  <div>
    <a href="#home">الرئيسية</a>
    &nbsp;&nbsp;
    <a href="#story">الحكاية</a>
    &nbsp;&nbsp;
    <a href="#message">الرسالة</a>
  </div>

</nav>


<!-- الرئيسية -->

<section class="hero" id="home">

<div class="content">

<div class="small">
  ✨ صفحة صنعت لشخص واحد فقط
</div>

<h1>
  إلى <span>عائشة</span>
</h1>

<p class="intro">
  في حاجات جميلة صعب تتقال بالكلام...
  فخلّي الكود يقولها بدلّي ❤️
</p>


<!-- القلب -->

<div class="heart-area" id="heart"></div>


<button class="btn main-btn"
onclick="scrollToMessage()">

  💌 عندي رسالة ليكي

</button>

</div>

</section>


<!-- الحكاية -->

<section id="story">

<div class="title">

<h2>ليه عائشة؟</h2>

<p>ثلاث حاجات بسيطة...</p>

</div>


<div class="cards">

<div class="card">

<div class="icon">🌹</div>

<h3>وجودك</h3>

<p>
في أشخاص وجودهم بيضيف حاجة جميلة
لليوم من غير ما يعملوا أي حاجة.
</p>

</div>


<div class="card">

<div class="icon">✨</div>

<h3>ابتسامتك</h3>

<p>
ابتسامة واحدة ممكن تغيّر شكل يوم كامل
وتخلّي اللحظة أحلى.
</p>

</div>


<div class="card">

<div class="icon">❤️</div>

<h3>مكانتك</h3>

<p>
مش كل شخص بياخد مكان خاص في القلب،
بس في أشخاص بيكون لهم مكان مختلف.
</p>

</div>

</div>

</section>


<!-- الرسالة -->

<section id="message">

<div class="title">

<h2>رسالة من القلب</h2>

<p>اقرئيها براحتك ❤️</p>

</div>


<div class="message-box">

<div id="messageText">
عائشة... ❤️
<br>
يمكن الكلام ده بسيط،
لكن كل كلمة فيه معمولة مخصوص عشانك.
</div>

<button
class="btn main-btn"
onclick="changeMessage()">

  ✨ رسالة أخرى

</button>

</div>

</section>


<!-- المفاجأة -->

<section class="surprise">

<div class="title">

<h2>وفي الآخر...</h2>

<p>في حاجة صغيرة مستنياكي</p>

</div>

<button
class="btn main-btn"
onclick="surprise()">

  🎁 اضغطي هنا

</button>

<div class="secret" id="secret"></div>

</section>


<footer>

صنع بحب لـ <span>عائشة ❤️</span>

</footer>


<script>

/* النجوم */

const stars =
document.getElementById("stars");

for(let i=0;i<90;i++){

  const s =
  document.createElement("div");

  s.className="star";

  s.style.left =
  Math.random()*100+"%";

  s.style.top =
  Math.random()*100+"%";

  s.style.animationDelay =
  Math.random()*3+"s";

  stars.appendChild(s);
}


/* تكوين القلب */

const heart =
document.getElementById("heart");

const total=170;

for(let i=0;i<total;i++){

  const t =
  Math.PI*2*i/total;

  const x =
  16*Math.pow(Math.sin(t),3);

  const y =
  13*Math.cos(t)
  -5*Math.cos(2*t)
  -2*Math.cos(3*t)
  -Math.cos(4*t);

  const word =
  document.createElement("span");

  word.className="word";

  word.innerText="I LOVE YOU";

  word.style.left =
  (180+x*9)+"px";

  word.style.top =
  (155-y*9)+"px";

  heart.appendChild(word);

  setTimeout(()=>{

    word.classList.add("show");

  },i*38);
}


/* الرسائل */

const messages=[

"عائشة، يمكن الكلام مش قادر يوصف كل اللي جوايا، لكن حبيت أعمل حاجة مختلفة عشان أقولك إنك شخص مميز جدًا بالنسبة لي. ❤️",

"في ناس بنقابلهم في حياتنا بالصدفة، وبعدها نكتشف إن وجودهم بقى له معنى كبير... وإنتِ واحدة من الناس دي. ✨",

"أتمنى دايمًا تكوني مبسوطة، وتفضلي شايفة قد إيه وجودك ممكن يكون سبب في لحظة حلوة لشخص تاني. 🌹",

"لو سألتيني إيه أجمل حاجة في الصفحة دي؟ هقولك إن كل الكلام اللي فيها في الآخر بيوصل لشخص واحد... عائشة. ❤️"

];

let current=0;


function changeMessage(){

  const box =
  document.getElementById("messageText");

  box.style.opacity=0;

  setTimeout(()=>{

    current++;

    if(current>=messages.length)
      current=0;

    box.innerText=messages[current];

    box.style.opacity=1;

  },500);
}


/* زر الرسالة */

function scrollToMessage(){

  document
  .getElementById("message")
  .scrollIntoView({
    behavior:"smooth"
  });

}


/* المفاجأة */

function surprise(){

  const secret =
  document.getElementById("secret");

  secret.innerHTML=
  "❤️ عائشة... إنتِ أجمل سبب خلّى الصفحة دي تتعمل ❤️";

}

</script>

</body>
</html>
